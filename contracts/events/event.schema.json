{
    "title": "Footfall Cam Analytics Event",
    "description": "A person crossing event generated by the computer vision pipeline.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "event_id",
        "store_id",
        "camera_id",
        "event_type",
        "timestamp",
        "track_id",
        "source"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "1.0"
        },
        "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "store_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "camera_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "event_type": {
            "type": "string",
            "enum": [
                "entry",
                "exit"
            ]
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "track_id": {
            "type": "integer",
            "minimum": 0
        },
        "source": {
            "type": "string",
            "const": "computer_vision"
        }
    }
}