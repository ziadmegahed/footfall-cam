{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "People Count Metrics",
    "type": "object",
    "required": [
        "schema_version",
        "store_id",
        "camera_id",
        "window_start",
        "window_end",
        "entries",
        "exits"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "1.0"
        },
        "store_id": {
            "type": "string",
            "minLength": 1
        },
        "camera_id": {
            "type": "string",
            "minLength": 1
        },
        "window_start": {
            "type": "string",
            "format": "date-time"
        },
        "window_end": {
            "type": "string",
            "format": "date-time"
        },
        "entries": {
            "type": "integer",
            "minimum": 0
        },
        "exits": {
            "type": "integer",
            "minimum": 0
        }
    },
    "additionalProperties": false
}